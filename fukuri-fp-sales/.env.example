# コピーして .env を作成（.env はコミット禁止）。Claude Code on the web では環境設定の「環境変数/シークレット」に登録する。
SFS_SPREADSHEET_ID=            # 営業管理スプレッドシートID
GOOGLE_APPLICATION_CREDENTIALS= # サービスアカウントJSONのパス（Sheets/Calendar用）
SFS_GMAIL_TOKEN_FILE=          # Gmail下書き用OAuthトークンJSON（scope: gmail.compose）
GBIZINFO_API_TOKEN=            # gBizINFO REST APIトークン（https://info.gbiz.go.jp/ で申請）
SFS_CALENDAR_ID=primary
SFS_PDF_FONT=                  # 案内PDFに埋め込む日本語フォント(.ttf)のパス（任意）
